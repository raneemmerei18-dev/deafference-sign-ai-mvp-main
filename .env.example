# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Local development default (assumes a local Postgres listening on localhost:5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deafference_dev?schema=public"

# Server Configuration
# Express API port. Kept distinct from the Next.js dev server (which uses 3000)
# so the frontend and API can run simultaneously.
PORT=4000
NODE_ENV=development

# Optional: Log level
LOG_LEVEL=debug

# Frontend: base URL the Next.js app uses to reach the Express API above.
# Must be NEXT_PUBLIC_* to be readable in the browser. Defaults to
# http://localhost:4000 in code if unset, so local dev works with no .env.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# BE-8: comma-separated list of origins the Express API accepts
# cross-origin requests from. Falls back to the two local dev ports below
# if unset, so local dev works with no .env changes.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://deafference.app"

# BE-10: POST /api/sentence gloss-to-English translation.
# LLM_PROVIDER picks which API key below is used ("openai" | "anthropic" |
# "gemini"). If unset, the first provider with a configured key wins
# (anthropic, then openai, then gemini). If none are set, or the call
# errors/times out, the endpoint falls back to a deterministic rule-based
# translator and responds with source: "rules" instead of failing.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Milliseconds to wait for the AI provider before falling back to rules.
SENTENCE_AI_TIMEOUT_MS=6000
